<?xml version="1.0" encoding="UTF-8"?>
<!--
  参考项目与 PetBot demo 清单（repo manifest）。

  用途：统一管理 reference_project/ 的上游仓库和 demo_project/ 的实验项目 —— 一条命令物化 / 更新全部，
  并用 revision 指定上游 commit 或我方专用分支。

  用法（在本仓库根目录执行）：
      repo init -u <本仓库的远端 URL> -m default.xml
      repo sync

  项目按 path 检出到 reference_project/ 或 demo_project/ 的子目录（被主线 .gitignore 排除）。

  注意：clone-depth 只对 <project> 生效，写在 <default> 上会被 repo 忽略（已实测）。

  维护规则：
  - 新增 / 删除 / 改变某个参考项目的 pin，必须在同一次改动中更新本文件与 reference_project/manifest.json。
  - 如果某个项目被我们改过（补丁 / 魔改），把改后的内容推到本仓库的一个专用分支，
    再把该项目的 remote/revision 指向那条分支，这样 repo sync 能直接拿到修改后的版本。
    参考分支命名 refproj/<项目名>，自有 demo 分支命名 demoproj/<项目名>。
  - demo 变更同步更新 demo_project/manifest.json；初始分支必须先推送后登记清单。
  - 我方自建的工具、脚本与实验定义也在同一命名空间下备份（例如 refproj/recovery-tools，
    内容在 tools/recovery_trial/），但它们不是上游项目，因此不写进本清单。
-->
<manifest>

  <remote name="github" fetch="https://github.com/" review="https://github.com/" />
  <!-- 我们自己的仓库：用于存放参考项目修改（refproj/*）和自有实验（demoproj/*） -->
  <remote name="ours" fetch="https://github.com/uglycatcat/" review="https://github.com/" />

  <default remote="github" revision="main" sync-j="4" />

  <!-- PetBot 自有实验：代码已推送到专用分支；开发 checkout 保留完整历史，便于提交/推送。
       同步来源与版本记录见 demo_project/manifest.json。禁止直接同步正在训练的代码副本。 -->
  <project name="petbot2_rl"
           path="demo_project/recovery_agile_01"
           remote="ours"
           revision="demoproj/recovery_agile_01"
           groups="demo" />
  <project name="petbot2_rl"
           path="demo_project/jump_rl_demo"
           remote="ours"
           revision="demoproj/jump_rl_demo"
           groups="demo" />

  <!-- 训练框架 / 工程参考 -->
  <project name="fan-ziqi/robot_lab"
           path="reference_project/robot_lab"
           revision="500399ed75f510aeaff28705a8ce736c514dbec3"
           clone-depth="1"
           groups="framework" />

  <!-- 策略验证与部署（MuJoCo 通路） -->
  <project name="fan-ziqi/rl_sar"
           path="reference_project/rl_sar"
           revision="376d42c9b128f963ab08579762d5a216a976ce39"
           clone-depth="1"
           groups="deploy" />

  <!-- 轮足倒地起身：当前试训对象及其相关参考 -->
  <!-- recovery 我们改过（论文口径补丁 + dump_pickle 兼容）：内容改取本仓库分支 refproj/recovery；
       原始上游为 Kitjesen/recovery @ 5b57477598963695be27474c0ba941a1ba4afd38（来源见 manifest.json） -->
  <project name="petbot2_rl"
           path="reference_project/recovery"
           remote="ours"
           revision="refproj/recovery"
           clone-depth="1"
           groups="recovery" />
  <project name="boyuandeng/Recovery_go2w"
           path="reference_project/Recovery_go2w"
           revision="e6424625011fbddebe74a2ea0b496fae324b6778"
           clone-depth="1"
           groups="recovery" />
  <project name="nvidia-isaac/WBC-AGILE"
           path="reference_project/WBC-AGILE"
           revision="6830cf995714e81c91ce63247e8e016d36e28f14"
           clone-depth="1"
           groups="recovery" />
  <project name="2350575870/getup_gym"
           path="reference_project/getup_gym"
           revision="238d2962a0fee8e3da4da914cadcea2be00ce402"
           clone-depth="1"
           groups="recovery" />
  <project name="RunpeiDong/HumanUP"
           path="reference_project/HumanUP"
           revision="7516e0f27e6f4d1e7365cf64ea577a78247bd8cb"
           clone-depth="1"
           groups="recovery" />

  <!-- 局部实现对照 -->
  <project name="limxdynamics/tron2_rl_lab"
           path="reference_project/tron2_rl_lab"
           revision="db021b4016648a6ddc97fb0acbe5df882cd53fc5"
           clone-depth="1"
           groups="reference" />
  <project name="LauraMQuiros/b2w-rl"
           path="reference_project/b2w-rl"
