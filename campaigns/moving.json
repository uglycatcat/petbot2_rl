{
  "name": "upright_moving",
  "task": "moving takeover + rear-wheel-supported remote driving",
  "container": "petbot-upright-night",
  "num_envs": 2048,
  "iterations": 1500,
  "checkpoints": [
    250,
    750,
    1499
  ],
  "envelope": {
    "speed_limit": 0.1,
    "yaw_limit": 0.3,
    "frame_min": -0.3,
    "frame_max": 0.3,
    "wheel_mode": "common_diff",
    "wheel_slew": 900.0,
    "learning_rate": 0.0001
  },
  "decision_rules": {
    "min_hold_gain": 8,
    "require_path_mae_gain": true,
    "scope": "native",
    "note": "gain is (B hold2s - A hold2s) over two seeds, i.e. out of 128; a change that also worsens tracking MAE does not count as an advantage"
  },
  "open_layers": [
    "instrumentation: contact/history sampling, extra logged signals",
    "observation: fields, history length, normalization",
    "action: coordinates, ranges, rate limits, smoothing",
    "reward: structure, scales, stage credit",
    "termination: failure conditions, timeout, warmup gate",
    "curriculum: envelope schedule, initialization mix",
    "control: decimation, filter constants",
    "initialization: source checkpoint, takeover gating"
  ],
  "fixed_constraints": [
    "scope stays four-wheel-contact normal driving takeover; no fallen recovery",
    "robot_description/ MJCF, STL and servo gains are read-only",
    "success thresholds are never relaxed: support 1 s, raw dv<0.12 m/s, dw<0.3 rad/s, path<0.15 m, heading<0.25 rad, head/ear<0.05 rad, roll<0.15, tilt_rate<0.8/s",
    "three action channels, frame position + rear wheel velocity only; head and ears fixed",
    "one batch at a time from a clean fixed commit; 78% whole-card memory guard",
    "wide envelope is evaluation-only until the trained envelope holds",
    "task scope and success criteria changes need the user"
  ],
